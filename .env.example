# Gemini (để trống nếu chạy offline fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2

# auto | gemini | offline
MEDLAB_LLM_MODE=auto
MEDLAB_RISK_MODEL_PATH=artifacts/risk_model.joblib
MEDLAB_RISK_MODEL_META_PATH=artifacts/model_card.json
MEDLAB_MAX_NOTE_CHARS=500
MEDLAB_LOG_LEVEL=INFO
